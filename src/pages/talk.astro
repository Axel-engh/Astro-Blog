---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout>
  <form class="w-[70%] mx-auto flex flex-col gap-6  my-[5%]">

  <div class="flex flex-col gap-2 mx-[15%]">
    <label for="name" class="text-sm font-medium">
      Name
    </label>
    <input
      id="name"
      type="text"
      placeholder="Your name"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400"
    />
  </div>

  <div class="flex flex-col gap-2 mx-[15%]">
    <label for="email" class="text-sm font-medium">
      Email
    </label>
    <input
      id="email"
      type="email"
      placeholder="you@example.com"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400"
    />
  </div>

  <div class="flex flex-col gap-2 mx-[15%]">
    <label for="message" class="text-sm font-medium">
      Message
    </label>
    <textarea
      id="message"
      rows="5"
      placeholder="Tell me about your project..."
      class="border border-gray-300 rounded-lg px-4 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-gray-400"
    ></textarea>
  </div>

  <button
    type="submit"
    class="mt-2 rounded-lg bg-black text-white py-3 font-medium hover:opacity-90 transition mx-[15%]"
  >
    Send message
  </button>
</form>

</BaseLayout>
