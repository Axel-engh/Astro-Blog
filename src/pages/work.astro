---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---
<BaseLayout>
 <section class="mt-24">
  <h2 class="mb-10 text-3xl font-bold text-slate-900 dark:text-slate-100">
    Work
  </h2>

  <!-- CONTENEDOR -->
  <div class="mx-auto flex max-w-5xl gap-10">

    <!-- CARD 1 -->
    <article class="w-1/3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Frontend Developer
      </h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Real Estate Agency · 2023 — Present
      </p>

      <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
        Building clean and accessible web interfaces focused on performance.
      </p>

      <ul class="mt-3 list-disc space-y-1 pl-4 text-sm text-slate-700 dark:text-slate-300">
        <li>Reusable components</li>
        <li>Responsive layouts</li>
        <li>Clean structure</li>
      </ul>

      <div class="mt-4 flex gap-2">
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">HTML</span>
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">CSS</span>
      </div>
    </article>

    <!-- CARD 2 -->
    <article class="w-1/3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Freelance Project
      </h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Client Website · 2024
      </p>

      <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
        Developed a responsive website with a clean and modern UI.
      </p>

      <ul class="mt-3 list-disc space-y-1 pl-4 text-sm text-slate-700 dark:text-slate-300">
        <li>SEO-friendly</li>
        <li>Accessible layout</li>
        <li>Fast load times</li>
      </ul>

      <div class="mt-4 flex gap-2">
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">Tailwind</span>
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">HTML</span>
      </div>
    </article>

    <!-- CARD 3 -->
    <article class="w-1/3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Personal Project
      </h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Portfolio · 2025
      </p>

      <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
        Personal portfolio focused on clarity and maintainability.
      </p>

      <ul class="mt-3 list-disc space-y-1 pl-4 text-sm text-slate-700 dark:text-slate-300">
        <li class="text-red-500 text-4xl">Component-based</li>
        <li>Dark / light mode</li>
        <li>Clean UI</li>
      </ul>

      <div class="mt-4 flex gap-2">
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">Astro</span>
        <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">Tailwind</span>
      </div>
    </article>

  </div>
</section>

</BaseLayout>
