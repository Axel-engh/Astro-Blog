---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import work1 from "../WORK1.webp";
import work2 from "../WORK2.webp";
import work3 from "../WORK3.webp";
---

<BaseLayout>
  <div class="grid my-[5%] mx-[15%] justify-center text-center">
    <h1>Selected Work</h1>
    <h2>
      A selection of projects where I combine <span class="destac"
        >modern web design</span
      >, <span class="destac">frontend development</span>, and <span
        class="destac">clean code</span
      > to build functional and <span class="destac"
        >user-focused interfaces</span
      >.
    </h2>
  </div>
  <div class="contgrid general flex gap-6 mx-[15%] mb-[5%]">
    <div class="cont flex-1 border p-4">
      <img src={work1.src} />
      <h3 class="mb-2 text-lg font-semibold">Proyecto 1</h3>
      <p class="text-sm text-gray-600">Descripción breve del proyecto.</p>
    </div>

    <div class="cont flex-1 border p-4">
      <img src={work1.src} />
      <h3 class="mb-2 text-lg font-semibold">Proyecto 2</h3>
      <p class="text-sm text-gray-600">Descripción breve del proyecto.</p>
    </div>

    <div class="cont flex-1 border border-gray-300 bg-white p-4">
      <img src={work1.src} />
      <h3 class="mb-2 text-lg font-semibold">Proyecto 3</h3>
      <p class="text-sm text-gray-600">Descripción breve del proyecto.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .general {
    gap: 40px;
  }

  img {
    width: 100%;
    height: 70%;
  }

  img:hover {
    width: 100%;
    height: 350px;
    position: relative;
    box-shadow: rgb(38, 57, 77) 0px 20px 30px -10px;
  }

  @media screen and (max-width: 870px) {

  .contgrid {
    display: grid;
  }
}

</style>
