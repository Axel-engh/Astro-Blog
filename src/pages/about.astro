---

import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";


---
<BaseLayout>
  <div class="base flex mx-[15%] my-[5%]">
  <div class="flex flex-col justify-center items-left px-4 sm:px-20 md:px-40 lg:px-60 xl:px-72 py-20 min-h-[30pc]">
    <h1 class="text-center text-[32px] sm                 :text-xl md:text-left text-2xl lg:text-3xl leading-relaxed">
      Hi, I’m <span class="worddes">Axel Dorantes.</span>
<span class="destac">Frontend Developer</span> focused on <span class="destac">clean</span> and <span class="destac">functional web experiences.</span>
    </h1>
    <h2 class="text-center text-[18px] sm:text-lg md:text-left text-xl lg:text-2xl mt-4 leading-relaxed">
      I’m a frontend developer focused on building clear, accessible, and <span class="destac">well-structured</span> web experiences. I mainly work with <span class="destac">HTML</span>, <span class="destac">CSS</span>, and modern frameworks like <span class="destac">Astro</span> and <span class="destac">Tailwind</span>, paying close attention to both design and <span class="destac">performance</span>.
    </h2>
    <h2 class="text-center text-[18px] sm:text-lg md:text-left text-xl lg:text-2xl mt-4 leading-relaxed">
      I enjoy <span class="destac">solving problems</span> in a practical way, writing <span class="destac">clean code</span>, and keeping projects <span class="destac">well organized</span>. When I face something new, I research and experiment to move projects forward without blocking progress.
    <h2 class="text-center text-[18px] sm:text-lg md:text-left text-xl lg:text-2xl mt-4 leading-relaxed">
      I’m currently looking for frontend development opportunities, freelance projects, or collaborations where I can keep learning while contributing real value from day one.
    </h2>
  </div>
  <div class="flex items-center justify-center my-[5%] md:justify-end">
    <img src="/img/user-cambiar.webp" class="w-[90%] rounded-full">
  </div>
  </div>
</BaseLayout>

